{
  "version": 2,
  "builds": [
    {
      "src": "reache/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12",
        "maxLambdaSize": "50mb",
        "includeFiles": "**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "reache/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_DEBUG": "0"
  }
}
